{
  "name": "lumina-translate",
  "version": "1.0.0",
  "description": "Modern Quick Translate Tool",
  "author": "Ilker Tuna",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.19.2",
    "screenshot-desktop": "^1.15.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.bytuna.luminatranslate",
    "productName": "Lumina Translate",
    "asar": true,
    "files": [
      "main.js",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}